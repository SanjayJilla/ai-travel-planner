# ==========================================
# Core LLM API Key (Get free at https://console.groq.com)
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# Optional External Tools & APIs
# (Agents use smart fallback knowledge if left empty)
# ==========================================
TAVILY_API_KEY=your_tavily_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ==========================================
# Optional Database Memory
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_memory_demo
